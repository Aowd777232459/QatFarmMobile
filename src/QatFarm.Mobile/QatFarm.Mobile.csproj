<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>QatFarm.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>نظام زراعي عواد سوفت</ApplicationTitle>
    <ApplicationId>com.qatfarm.mobile</ApplicationId>
    <ApplicationDisplayVersion>2.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>40</ApplicationVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidUseAapt2>true</AndroidUseAapt2>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    <UseMonoRuntime>true</UseMonoRuntime>
    <RunAOTCompilation>false</RunAOTCompilation>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#073D2A" BaseSize="512,512" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#073D2A" BaseSize="512,512" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
  </ItemGroup>
</Project>
