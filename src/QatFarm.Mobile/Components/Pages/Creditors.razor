@page "/creditors"
@inject QatFarmService Service
@inject AppSession Session

<div class="page-head"><div><h1>الدائنون والموردون</h1><span class="erp-subtitle">سجل الجهات الدائنة</span></div><button class="btn primary" @onclick="Reset">＋ دائن</button></div>
<div class="summary-strip"><span>عدد السجلات <b>@rows.Count</b></span></div>

<div class="panel erp-entry-panel">
 <div class="erp-box-title">@(model.Id==0?"بيانات دائن جديد":"تعديل الدائن")</div>
 <EditForm Model="model" OnValidSubmit="SaveAsync">
  <div class="form-grid">
   <div><label>الاسم</label><InputText class="form-control" @bind-Value="model.Name" /></div>
   <div><label>الهاتف</label><InputText class="form-control" @bind-Value="model.Phone" /></div>
   <div><label>العنوان</label><InputText class="form-control" @bind-Value="model.Address" /></div>
   <div class="span-2"><label>ملاحظات</label><InputText class="form-control" @bind-Value="model.Notes" /></div>
  </div>
  <div class="actions"><button class="btn primary">💾 حفظ</button><button type="button" class="btn ghost" @onclick="Reset">مسح</button></div>
 </EditForm>
 @if (!string.IsNullOrEmpty(message)) { <div class="alert @(ok?"success":"danger")">@message</div> }
</div>

<div class="erp-register-head"><strong>سجل الدائنين</strong><span>@rows.Count سجل</span></div>
<div class="card-list creditor-register">
@foreach (var x in rows)
{
 <article class="data-card farm-row">
  <div class="record-icon">د</div>
  <div class="grow"><strong>@x.Name</strong><small>@(string.IsNullOrWhiteSpace(x.Phone)?"بدون هاتف":x.Phone) · @(string.IsNullOrWhiteSpace(x.Address)?"بدون عنوان":x.Address)</small></div>
  @if (Session.IsAdmin)
  {
   <div class="actions vertical"><button class="btn small" @onclick="() => Edit(x)">تعديل</button><button class="btn small danger" @onclick="() => DeleteAsync(x.Id)">حذف</button></div>
  }
 </article>
}
</div>
@if(rows.Count==0){<div class="empty-state">لا يوجد دائنون.</div>}

@code {
 private List<Creditor> rows=[]; private Creditor model=new(); private string? message; private bool ok;
 protected override async Task OnInitializedAsync()=>await LoadAsync();
 private async Task LoadAsync()=>rows=await Service.GetCreditorsAsync();
 private async Task SaveAsync(){try{await Service.SaveCreditorAsync(model);ok=true;message="تم الحفظ.";Reset();await LoadAsync();}catch(Exception ex){ok=false;message=ex.Message;}}
 private void Edit(Creditor x)=>model=new Creditor{Id=x.Id,Name=x.Name,Phone=x.Phone,Address=x.Address,Notes=x.Notes,IsActive=x.IsActive,CreatedAt=x.CreatedAt};
 private void Reset()=>model=new Creditor();
 private async Task DeleteAsync(long id){try{await Service.DeleteCreditorAsync(id);await LoadAsync();ok=true;message="تم الحذف.";}catch(Exception ex){ok=false;message=ex.Message;}}
}
