@page "/customers"
@inject QatFarmService Service
@inject AppSession Session

<div class="page-head">
 <div><h1>العملاء والديون</h1><span class="erp-subtitle">حسابات العملاء والحدود الائتمانية</span></div>
 <button class="btn primary" @onclick="Reset">＋ عميل</button>
</div>

<div class="summary-strip customer-summary">
 <span>العملاء <b>@rows.Count</b></span>
 <span>إجمالي الديون <b>@rows.Sum(x => x.Balance).ToString("N2")</b></span>
 <span>بلغوا الحد <b>@rows.Count(x => x.Balance >= x.Customer.CreditLimit && x.Balance > 0)</b></span>
</div>

<div class="panel erp-entry-panel">
 <div class="erp-box-title">بيانات العميل</div>
 <EditForm Model="model" OnValidSubmit="SaveAsync">
  <div class="form-grid">
   <div><label>اسم العميل</label><InputText class="form-control" @bind-Value="model.Name" /></div>
   <div><label>رقم العميل</label><InputText class="form-control" @bind-Value="model.Phone" placeholder="777123456" /></div>
   <div><label>رقم البائع</label><InputText class="form-control" @bind-Value="model.SellerPhone" /></div>
   <div><label>المنطقة</label><InputText class="form-control" @bind-Value="model.Region" /></div>
   <div><label>الرصيد الافتتاحي</label><InputNumber class="form-control" @bind-Value="model.OpeningBalance" /></div>
   <div><label>الحد الائتماني</label><InputNumber class="form-control" @bind-Value="model.CreditLimit" /></div>
   <div><label>العنوان</label><InputText class="form-control" @bind-Value="model.Address" /></div>
   <div><label>ملاحظات</label><InputText class="form-control" @bind-Value="model.Notes" /></div>
   <div class="erp-check-field"><label class="checkbox-line"><InputCheckbox @bind-Value="model.DebtAlertEnabled" /> تنبيه الحد الائتماني</label></div>
  </div>
  <div class="actions"><button class="btn primary">💾 حفظ</button><button type="button" class="btn ghost" @onclick="Reset">مسح</button></div>
 </EditForm>
 @if (!string.IsNullOrEmpty(message)){<div class="alert @(ok?"success":"danger")">@message</div>}
</div>

<div class="erp-register-head"><strong>سجل العملاء</strong><span>@rows.Count سجل</span></div>
<div class="card-list customer-register">
@foreach (var row in rows)
{
 var available = Math.Max(0, row.Customer.CreditLimit - row.Balance);
 var limitReached = row.Balance >= row.Customer.CreditLimit && row.Balance > 0;
 <article class="data-card customer-account-card @(limitReached ? "credit-limit-reached" : "")">
  <div class="grow customer-account-main">
   <div class="customer-title-line"><strong>@row.Customer.Name</strong>@if(limitReached){<span class="badge danger">بلغ الحد</span>}</div>
   <small>@(row.Customer.Phone ?? "بدون رقم") · @row.Customer.Region</small>
   <div class="account-values">
    <div><span>الدين</span><strong>@row.Balance.ToString("N2")</strong></div>
    <div><span>الحد</span><strong>@row.Customer.CreditLimit.ToString("N2")</strong></div>
    <div><span>المتاح</span><strong>@available.ToString("N2")</strong></div>
   </div>
  </div>
  <div class="actions vertical">
   @if (Session.CanRecordPayments && row.Balance > 0)
   { <button class="btn small success" @onclick="() => StartPayment(row)">دفعة</button> }
   @if (Session.IsAdmin)
   {
    <button class="btn small" @onclick="() => Edit(row.Customer)">تعديل</button>
    <button class="btn small danger" @onclick="() => DeleteAsync(row.Customer.Id)">حذف</button>
   }
  </div>
 </article>
}
</div>
@if(rows.Count==0){<div class="empty-state">لا يوجد عملاء.</div>}

@if (paymentCustomer is not null)
{
 <div class="modal-backdrop"><div class="modal-card">
  <h2>تسجيل دفعة — @paymentCustomer.Customer.Name</h2>
  <label>المبلغ</label><InputNumber class="form-control" @bind-Value="paymentAmount" />
  <label>طريقة الدفع</label><InputSelect class="form-control" @bind-Value="paymentMethod">
   <option value="@PaymentMethod.Cash">نقدي</option><option value="@PaymentMethod.Transfer">تحويل</option>
  </InputSelect>
  <label>المرجع</label><input class="form-control" @bind="paymentReference" />
  <div class="actions"><button class="btn success" @onclick="SavePaymentAsync">تأكيد</button><button class="btn ghost" @onclick="ClosePayment">إلغاء</button></div>
 </div></div>
}

@code {
 private List<CustomerBalanceRow> rows=[]; private Customer model=new(){CreditLimit=100000m,DebtAlertEnabled=true}; private string? message; private bool ok;
 private CustomerBalanceRow? paymentCustomer; private decimal paymentAmount;
 private PaymentMethod paymentMethod=PaymentMethod.Cash; private string? paymentReference;
 protected override async Task OnInitializedAsync()=>await LoadAsync();
 private async Task LoadAsync()=>rows=await Service.GetCustomersAsync();
 private async Task SaveAsync(){try{await Service.SaveCustomerAsync(model);ok=true;message="تم الحفظ.";Reset();await LoadAsync();}catch(Exception ex){ok=false;message=ex.Message;}}
 private void Edit(Customer x)=>model=new Customer{Id=x.Id,SyncKey=x.SyncKey,Name=x.Name,Phone=x.Phone,SellerPhone=x.SellerPhone,Region=x.Region,Address=x.Address,OpeningBalance=x.OpeningBalance,CreditLimit=x.CreditLimit,DebtAlertEnabled=x.DebtAlertEnabled,LastDebtAlertAt=x.LastDebtAlertAt,LastDebtAlertBalance=x.LastDebtAlertBalance,LastDebtAlertLimit=x.LastDebtAlertLimit,Notes=x.Notes,IsActive=x.IsActive,CreatedAt=x.CreatedAt};
 private void Reset()=>model=new Customer{CreditLimit=100000m,DebtAlertEnabled=true};
 private async Task DeleteAsync(long id){try{await Service.DeleteCustomerAsync(id);await LoadAsync();}catch(Exception ex){ok=false;message=ex.Message;}}
 private void StartPayment(CustomerBalanceRow row){paymentCustomer=row;paymentAmount=row.Balance;paymentReference=null;}
 private void ClosePayment(){paymentCustomer=null;paymentAmount=0;}
 private async Task SavePaymentAsync(){if(paymentCustomer is null)return;try{await Service.AddCustomerPaymentAsync(paymentCustomer.Customer.Id,null,paymentAmount,paymentMethod,paymentReference);ClosePayment();ok=true;message="تم تسجيل الدفعة.";await LoadAsync();}catch(Exception ex){ok=false;message=ex.Message;}}
}
