@page "/customers"
@inject QatFarmService Service
@inject AppSession Session

<h1>العملاء والديون</h1>
<div class="panel">
 <EditForm Model="model" OnValidSubmit="SaveAsync">
  <div class="form-grid">
   <div><label>اسم العميل</label><InputText class="form-control" @bind-Value="model.Name" /></div>
   <div><label>رقم العميل</label><InputText class="form-control" @bind-Value="model.Phone" placeholder="مثال: 777123456" /></div>
   <div><label>رقم البائع المرتبط</label><InputText class="form-control" @bind-Value="model.SellerPhone" placeholder="رقم البائع للتواصل" /></div>
   <div><label>المنطقة</label><InputText class="form-control" @bind-Value="model.Region" /></div>
   <div><label>الرصيد الافتتاحي</label><InputNumber class="form-control" @bind-Value="model.OpeningBalance" /></div>
   <div><label>الحد الائتماني</label><InputNumber class="form-control" @bind-Value="model.CreditLimit" /></div>
  </div>
  <div class="inline-warning">الحد الافتراضي للعميل الجديد 100,000 ر.ي. يمكنك تغييره لأي مبلغ. عند محاولة تجاوز الحد يوقف النظام الزيادة ويرسل تنبيه SMS إلى رقم العميل من شريحة الهاتف.</div>
  <label class="checkbox-line"><InputCheckbox @bind-Value="model.DebtAlertEnabled" /> تفعيل رسالة SMS عند بلوغ/تجاوز الحد</label>
  <label>العنوان</label><InputText class="form-control" @bind-Value="model.Address" />
  <label>ملاحظات</label><InputTextArea class="form-control" @bind-Value="model.Notes" />
  <div class="actions"><button class="btn primary">حفظ</button><button type="button" class="btn ghost" @onclick="Reset">جديد</button></div>
 </EditForm>
 @if (!string.IsNullOrEmpty(message)){<div class="alert @(ok?"success":"danger")">@message</div>}
</div>

<div class="card-list">
@foreach (var row in rows)
{
 var available = Math.Max(0, row.Customer.CreditLimit - row.Balance);
 var limitReached = row.Balance >= row.Customer.CreditLimit && row.Balance > 0;
 <div class="data-card @(limitReached ? "credit-limit-reached" : "")">
  <div class="grow">
   <strong>@row.Customer.Name</strong>
   <small>العميل: @(row.Customer.Phone ?? "بدون رقم") — البائع: @(row.Customer.SellerPhone ?? "غير محدد") — @row.Customer.Region</small>
   <div class="money-line"><span>الدين: <b>@row.Balance.ToString("N2")</b></span><span>الحد: <b>@row.Customer.CreditLimit.ToString("N2")</b></span><span>المتاح: <b>@available.ToString("N2")</b></span></div>
   @if (limitReached)
   { <div class="alert danger">⚠ بلغ العميل الحد الائتماني. لا يُسمح بزيادة الدين.</div> }
   else if (row.Customer.CreditLimit > 0 && row.Balance >= row.Customer.CreditLimit * 0.8m)
   { <div class="inline-warning">تنبيه: العميل استخدم أكثر من 80% من الحد الائتماني.</div> }
  </div>
  <div class="actions vertical">
   @if (Session.CanRecordPayments && row.Balance > 0)
   { <button class="btn small success" @onclick="() => StartPayment(row)">دفعة</button> }
   @if (Session.IsAdmin)
   {
    <button class="btn small" @onclick="() => Edit(row.Customer)">تعديل</button>
    <button class="btn small danger" @onclick="() => DeleteAsync(row.Customer.Id)">حذف</button>
   }
   else
   {
    <button class="btn small locked-btn" disabled>🔒 تعديل المدير</button>
    <button class="btn small locked-btn" disabled>🔒 حذف المدير</button>
   }
  </div>
 </div>
}
</div>

@if (paymentCustomer is not null)
{
 <div class="modal-backdrop"><div class="modal-card">
  <h2>تسجيل دفعة: @paymentCustomer.Customer.Name</h2>
  <label>المبلغ</label><InputNumber class="form-control" @bind-Value="paymentAmount" />
  <label>طريقة الدفع</label><InputSelect class="form-control" @bind-Value="paymentMethod">
   <option value="@PaymentMethod.Cash">نقدي</option><option value="@PaymentMethod.Transfer">تحويل</option>
  </InputSelect>
  <label>المرجع</label><input class="form-control" @bind="paymentReference" />
  <div class="actions"><button class="btn success" @onclick="SavePaymentAsync">حفظ</button><button class="btn ghost" @onclick="ClosePayment">إلغاء</button></div>
 </div></div>
}

@code {
 private List<CustomerBalanceRow> rows=[]; private Customer model=new(); private string? message; private bool ok;
 private CustomerBalanceRow? paymentCustomer; private decimal paymentAmount;
 private PaymentMethod paymentMethod=PaymentMethod.Cash; private string? paymentReference;
 protected override async Task OnInitializedAsync()=>await LoadAsync();
 private async Task LoadAsync()=>rows=await Service.GetCustomersAsync();
 private async Task SaveAsync(){try{await Service.SaveCustomerAsync(model);ok=true;message="تم حفظ العميل والحد الائتماني.";Reset();await LoadAsync();}catch(Exception ex){ok=false;message=ex.Message;}}
 private void Edit(Customer x)=>model=new Customer{Id=x.Id,SyncKey=x.SyncKey,Name=x.Name,Phone=x.Phone,SellerPhone=x.SellerPhone,Region=x.Region,Address=x.Address,OpeningBalance=x.OpeningBalance,CreditLimit=x.CreditLimit,DebtAlertEnabled=x.DebtAlertEnabled,LastDebtAlertAt=x.LastDebtAlertAt,LastDebtAlertBalance=x.LastDebtAlertBalance,LastDebtAlertLimit=x.LastDebtAlertLimit,Notes=x.Notes,IsActive=x.IsActive,CreatedAt=x.CreatedAt};
 private void Reset()=>model=new Customer{CreditLimit=100000m,DebtAlertEnabled=true};
 private async Task DeleteAsync(long id){try{await Service.DeleteCustomerAsync(id);await LoadAsync();}catch(Exception ex){ok=false;message=ex.Message;}}
 private void StartPayment(CustomerBalanceRow row){paymentCustomer=row;paymentAmount=row.Balance;paymentReference=null;}
 private void ClosePayment(){paymentCustomer=null;paymentAmount=0;}
 private async Task SavePaymentAsync(){if(paymentCustomer is null)return;try{await Service.AddCustomerPaymentAsync(paymentCustomer.Customer.Id,null,paymentAmount,paymentMethod,paymentReference);ClosePayment();ok=true;message="تم تسجيل الدفعة وتحديث دين العميل.";await LoadAsync();}catch(Exception ex){ok=false;message=ex.Message;}}
}
