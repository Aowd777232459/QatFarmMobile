@page "/settings"
@inject BackupService Backup
@inject AppSession Session
@inject LocalSyncService LocalSync
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop
@implements IDisposable
<h1>الإعدادات والنسخ الاحتياطي</h1>
<div class="panel">
 <h2>المظهر</h2>
 <div class="preferences-grid settings-preferences-grid">
  <div><label>الألوان</label><select class="form-control" @bind="theme"><option value="green">الخضراء</option><option value="light">الفاتح</option><option value="dark">الداكن</option><option value="gold">الذهبية</option></select></div>
  <div><label>الخلفية</label><select class="form-control" @bind="background"><option value="none">بدون صورة</option><option value="farm">المزرعة</option><option value="rows">صفوف المزرعة</option><option value="qat">القات</option><option value="close">خلفية هادئة</option></select></div>
  <div><label>حجم الخط</label><select class="form-control" @bind="fontScale"><option value="0.9">صغير</option><option value="1">متوسط</option><option value="1.12">كبير</option><option value="1.22">كبير جدًا</option></select></div>
  <div><label>اللغة</label><select class="form-control" @bind="language"><option value="ar">العربية</option><option value="en">الإنجليزية</option></select></div>
 </div>
 <div class="settings-actions"><button class="btn primary" @onclick="SaveAppearance">حفظ المظهر</button></div>
</div>
<div class="panel">
 <h2>مزامنة Wi-Fi مع الكمبيوتر</h2>
 <div class="form-grid">
  <div><label>عنوان الكمبيوتر</label><input class="form-control" @bind="serverUrl" placeholder="192.168.1.5" inputmode="url" /></div>
  <div><label>رمز الربط</label><input class="form-control" @bind="pairingKey" placeholder="AWAD-XXXXXXXXXXXX" autocomplete="off" /></div>
 </div>
 <label class="check"><input type="checkbox" @bind="autoSync" /> مزامنة تلقائية</label>
 <div class="sync-status @(LocalSync.IsSyncing ? "busy" : "")">@LocalSync.LastMessage</div>
 <div class="settings-actions">
  <button class="btn primary" @onclick="SaveSyncAsync" disabled="@LocalSync.IsSyncing">حفظ واختبار الربط</button>
  <button class="btn" @onclick="SyncNowAsync" disabled="@LocalSync.IsSyncing">مزامنة الآن</button>
 </div>
</div>
<div class="panel">
 <h2>نسخة احتياطية محلية</h2>
 <div class="actions">
  <button class="btn primary @(Session.IsAdmin ? "" : "locked-btn")" @onclick="ExportAsync" disabled="@(!Session.IsAdmin)">إنشاء ومشاركة نسخة</button>
  <button class="btn danger @(Session.IsAdmin ? "" : "locked-btn")" @onclick="RestoreAsync" disabled="@(!Session.IsAdmin)">استعادة نسخة</button>
 </div>
 @if(!string.IsNullOrEmpty(message)){<div class="alert @(ok?"success":"danger")">@message</div>}
</div>
<div class="panel">
 <h2>معلومات التطبيق</h2>
 <div class="setting-row"><span>الإصدار</span><strong>3.0.0</strong></div>
 <div class="actions"><a class="btn ghost" href="/privacy">سياسة الخصوصية</a></div>
</div>
@code {
 private string? message; private bool ok;
 private string serverUrl = string.Empty; private string pairingKey = string.Empty; private bool autoSync = true;
 private string theme = "green"; private string background = "none"; private string fontScale = "1"; private string language = "ar";

 protected override void OnInitialized()
 {
  serverUrl = LocalSync.ServerUrl; pairingKey = LocalSync.PairingKey; autoSync = LocalSync.AutoSync;
  LocalSync.Changed += SyncChanged;
 }

 protected override async Task OnAfterRenderAsync(bool firstRender)
 {
  if (!firstRender) return;
  try
  {
   var prefs = await JS.InvokeAsync<AppearancePreferences>("awadUiPreferences.get");
   theme = string.IsNullOrWhiteSpace(prefs.Theme) ? "green" : prefs.Theme;
   background = string.IsNullOrWhiteSpace(prefs.Background) ? "none" : prefs.Background;
   fontScale = prefs.FontScale <= 0 ? "1" : prefs.FontScale.ToString(System.Globalization.CultureInfo.InvariantCulture);
   language = prefs.Language == "en" ? "en" : "ar";
   StateHasChanged();
  }
  catch { }
 }

 private async Task SaveAppearance()
 {
  var scale = double.TryParse(fontScale, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed) ? parsed : 1;
  await JS.InvokeVoidAsync("awadUiPreferences.save", new { theme, background, fontScale = scale, language });
  ok = true; message = "تم حفظ إعدادات المظهر.";
 }
 private async Task SaveSyncAsync(){await LocalSync.SavePreferencesAsync(serverUrl,pairingKey,autoSync);serverUrl=LocalSync.ServerUrl;}
 private async Task SyncNowAsync(){await LocalSync.SyncNowAsync();}
 private void SyncChanged()=>_ = InvokeAsync(StateHasChanged);
 public void Dispose()=>LocalSync.Changed-=SyncChanged;
 private async Task ExportAsync(){try{await Backup.ShareBackupAsync();ok=true;message="تم إنشاء النسخة وفتح المشاركة.";}catch(Exception ex){ok=false;message=ex.Message;}}
 private async Task RestoreAsync(){try{await Backup.RestoreBackupAsync();ok=true;message="تمت الاستعادة. أعد تشغيل التطبيق.";}catch(Exception ex){ok=false;message=ex.Message;}}
 private sealed class AppearancePreferences{public string Theme{get;set;}="green";public string Background{get;set;}="none";public double FontScale{get;set;}=1;public string Language{get;set;}="ar";}
}
