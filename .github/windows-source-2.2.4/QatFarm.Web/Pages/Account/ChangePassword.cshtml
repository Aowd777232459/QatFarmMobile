@page "/account/change-password"
@model QatFarm.Web.Pages.Account.ChangePasswordModel
@{ Layout = null; }
<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>تغيير كلمة المرور</title>
<style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:linear-gradient(135deg,#071c13,#17603a);font-family:Segoe UI,Tahoma;color:#183126;padding:20px}.card{width:min(500px,100%);background:#fff;border-radius:26px;padding:38px;box-shadow:0 25px 80px #001b0e99}.mark{width:65px;height:65px;border-radius:20px;display:grid;place-items:center;background:#e9f8ef;color:#08743f;font-size:30px}.card h1{margin:20px 0 8px}.card p{color:#687970;line-height:1.8}.field{margin:15px 0}.field label{display:block;font-weight:700;margin-bottom:7px}.field input{width:100%;height:52px;border:1px solid #dce7e0;border-radius:14px;padding:0 15px;font-size:16px}.btn{width:100%;height:54px;border:0;border-radius:15px;background:#107542;color:white;font-weight:800;font-size:16px;margin-top:14px}.validation{color:#a32626;background:#fff1f1;padding:12px;border-radius:12px}</style></head>
<body><form method="post" class="card"><div class="mark">✓</div><h1>تأمين حساب المدير</h1><p>هذه أول مرة تسجل فيها الدخول. غيّر كلمة المرور المؤقتة إلى كلمة قوية خاصة بك قبل استخدام النظام.</p><div asp-validation-summary="ModelOnly" class="validation"></div>
<div class="field"><label asp-for="Input.OldPassword">كلمة المرور المؤقتة</label><input asp-for="Input.OldPassword" /></div>
<div class="field"><label asp-for="Input.NewPassword">كلمة المرور الجديدة</label><input asp-for="Input.NewPassword" /></div>
<div class="field"><label asp-for="Input.ConfirmPassword">تأكيد كلمة المرور</label><input asp-for="Input.ConfirmPassword" /></div>
<button class="btn" type="submit">حفظ كلمة المرور والمتابعة</button></form></body></html>
