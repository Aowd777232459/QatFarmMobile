@page "/audit-logs"
@attribute [Authorize(Roles = "Administrator")]
@inject AuditLogService Service

<PageTitle>سجل التدقيق</PageTitle>

<div class="page-heading">
    <div>
        <span class="eyebrow">الرقابة والأمان</span>
        <h1>سجل التدقيق</h1>
        <p>تاريخ العمليات الحساسة ومن نفذها والقيم القديمة والجديدة.</p>
    </div>
    <button class="btn btn-outline" type="button" @onclick="Load">تحديث السجل</button>
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert danger">@error</div>
}

<section class="panel table-panel">
    <div class="panel-header">
        <div>
            <h2>آخر العمليات</h2>
            <p>يعرض حتى 1000 عملية مرتبة من الأحدث.</p>
        </div>
        <div class="search-box">
            <span>⌕</span>
            <input @bind="search" @bind:event="oninput" @onkeyup="Search" placeholder="العملية أو الجدول أو رقم السجل" />
        </div>
    </div>

    @if (loading)
    {
        <div class="loading-card">جارٍ تحميل سجل التدقيق…</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr><th>الوقت</th><th>المستخدم</th><th>العملية</th><th>الكيان</th><th>رقم السجل</th><th>IP</th><th>التفاصيل</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td class="nowrap">@row.ActionDate.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</td>
                            <td>@row.UserName</td>
                            <td><span class="status @ActionClass(row.Action)">@ActionText(row.Action)</span></td>
                            <td><code>@row.EntityName</code></td>
                            <td><code>@row.EntityId</code></td>
                            <td><code>@(row.IpAddress ?? "—")</code></td>
                            <td>
                                <details>
                                    <summary>عرض</summary>
                                    @if (!string.IsNullOrWhiteSpace(row.OldValues))
                                    {
                                        <b>قبل:</b><pre class="audit-json">@row.OldValues</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.NewValues))
                                    {
                                        <b>بعد:</b><pre class="audit-json">@row.NewValues</pre>
                                    }
                                    @if (string.IsNullOrWhiteSpace(row.OldValues) && string.IsNullOrWhiteSpace(row.NewValues))
                                    {
                                        <span>لا توجد قيم تفصيلية.</span>
                                    }
                                </details>
                            </td>
                        </tr>
                    }
                    @if (rows.Count == 0)
                    {
                        <tr><td colspan="7"><div class="empty-inline">لا توجد عمليات مطابقة.</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<AuditLogRow> rows = [];
    private string search = string.Empty;
    private string? error;
    private bool loading = true;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        loading = true;
        try
        {
            rows = await Service.GetAsync(search, 1000);
            error = null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private Task Search(KeyboardEventArgs _) => Load();

    private static string ActionText(string action)
    {
        if (action.Contains("Delete", StringComparison.OrdinalIgnoreCase)) return "حذف";
        if (action.Contains("Update", StringComparison.OrdinalIgnoreCase)) return "تعديل";
        if (action.Contains("Create", StringComparison.OrdinalIgnoreCase)) return "إضافة";
        if (action.Contains("Payment", StringComparison.OrdinalIgnoreCase)) return "دفعة";
        if (action.Contains("Cancel", StringComparison.OrdinalIgnoreCase)) return "إلغاء";
        return action;
    }

    private static string ActionClass(string action)
    {
        if (action.Contains("Delete", StringComparison.OrdinalIgnoreCase) ||
            action.Contains("Cancel", StringComparison.OrdinalIgnoreCase)) return "cancelled";
        if (action.Contains("Create", StringComparison.OrdinalIgnoreCase)) return "paid";
        return "partial";
    }
}
